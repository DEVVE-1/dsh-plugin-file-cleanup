{
  "name": "file-cleanup",
  "version": "1.3.0",
  "repository": "git+https://github.com/DEVVE-1/dsh-plugin-file-cleanup.git",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "cordis",
    "cleanup",
    "disk",
    "temp-files"
  ],
  "license": "MIT",
  "description": "左上角「文件清理」按钮：选「所有工作区」或「DSH_HOME」，二次确认后只删白名单内的垃圾文件，绝不越过所选范围。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/core.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node test/cleanup.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4"
  }
}
